<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>DPK.Foundation.AspNetCore</id>
    <version>1.1.5</version>
    <authors>Infrastructure</authors>
    <description>DPK.Foundation.AspNetCore</description>
    <tags>asp.net asp.net mvc boilerplate application framework web framework framework domain driven design asp.net core</tags>
    <dependencies>
      <group targetFramework="net6.0">
        <dependency id="DPK.Foundation.Web.Common" version="1.1.5" exclude="Build,Analyzers" />
        <dependency id="Castle.LoggingFacility.MsLogging" version="3.1.0" exclude="Build,Analyzers" />
        <dependency id="Castle.Windsor.MsDependencyInjection" version="3.4.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNetCore.Mvc.NewtonsoftJson" version="6.0.4" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" version="6.0.4" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net6.0">
        <frameworkReference name="Microsoft.AspNetCore.App" />
      </group>
    </frameworkReferences>
    <contentFiles>
      <files include="any/net6.0/libman.json" buildAction="Content" />
    </contentFiles>
  </metadata>
</package>